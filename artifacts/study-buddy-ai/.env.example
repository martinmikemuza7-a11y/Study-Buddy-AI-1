# Public frontend configuration. No secrets belong in VITE_* variables.
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PROXY_URL=
# Leave empty for same-origin API. For Cloudflare Pages + separately hosted API, use e.g. https://api.example.com
VITE_API_BASE_URL=
# Preserve the existing BASE_PATH. Use / for a root-domain Pages project.
BASE_PATH=/
